// See the Symbiont DSL guide: https://docs.symbiont.dev/dsl-guide

metadata {
    version = "0.1.0"
    author = "Symbiont Community"
    description = "Governed code reviewer that runs Claude Code as a Mode B managed subprocess"
    tags = ["code-review", "claude-code", "mode-b", "managed", "cli-executor"]
    executor = "claude_code"
    allowed_tools = "read_file,grep_files,list_files,git_diff,git_staged_diff,git_log,git_status"
    system_prompt = "You are a senior code reviewer running under Symbiont governance. Review the working tree (prefer the staged and unstaged diff) for correctness bugs, security issues, and clarity problems. Do NOT modify files. Produce a concise, severity-tagged list of findings with file:line references and a one-line summary verdict."
}

# Mode B (ORGA-managed) agent.
#
# `symbi run code_reviewer` reads `executor = "claude_code"` from the metadata
# above and takes the deterministic CliExecutor path instead of the ORGA
# reasoning loop. The contained child has a scratch workspace and private
# tool/inference channels. It accesses source only through these registered
# ToolClad tools, with preparation, policy and mandatory approval outside the
# child. Source mounts belong to the tool backends. The operator configures
# [managed_cli.inference] and an image containing Claude Code, Python and Git.
# Provider credentials and signed journals remain outside worker mounts.
#
# The policy below describes intent. Configure actual spawn and tool permits
# in policies/managed-cli; this managed route does not execute the DSL body.

agent code_reviewer(target: String) -> Review {
    capabilities = ["read", "analyze"]

    policy review_only {
        allow: ["read", "analyze"] if true
        deny: ["write_data", "execute_code", "network_access"]

        require: {
            input_sanitization: true
        }

        audit: {
            log_level: "info",
            include_findings: true
        }
    }

    with
        memory = "ephemeral",
        security = "high",
        sandbox = "Tier1"
    {
        return review(target);
    }
}
